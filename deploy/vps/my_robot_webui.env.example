# Copy to:
# /home/deploy/ros2_workspace/deploy/vps/my_robot_webui.env

ROS_SETUP=/opt/ros/humble/setup.bash
WORKSPACE_ROOT=/home/deploy/ros2_workspace
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8080
STACK_MODE=parking

# Optional but useful on headless VPS machines.
LIBGL_ALWAYS_SOFTWARE=1

# Keep secrets out of git.
OPENAI_API_KEY=

# Optional overrides.
OPENAI_COMMAND_MODEL=gpt-5.4-mini
OPENAI_COMMAND_TIMEOUT_SEC=12
